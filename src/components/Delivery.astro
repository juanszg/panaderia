---
import ProductCard from './ProductCard.astro';
import { categories } from '../data/catalog.js';
---
<section id="delivery" class="section bg-[#e9edc9]"><div class="shell reveal"><div class="mb-10 max-w-xl"><p class="eyebrow">Delivery</p><h2 class="serif mt-2 text-5xl leading-none sm:text-6xl">Elige lo que se <em class="text-[#a97048]">horneó para ti.</em></h2><p class="mt-4 text-sm leading-7 text-[#6f6256]">Arma tu pedido y envíalo directamente por WhatsApp. Recibimos cada orden con mucho cuidado.</p></div><div class="grid gap-7 lg:grid-cols-[1fr_365px]"><div><div class="mb-5 flex flex-wrap gap-2" role="tablist" aria-label="Categorías">{categories.map((category,index)=><button class:list={['category rounded-full border px-4 py-2 text-xs font-bold transition',index===0?'border-[#d4a373] bg-[#d4a373] text-white':'border-[#d4a373]/45 text-[#675847]']} data-category={category.name} role="tab" aria-selected={index===0}>{category.name}</button>)}</div>{categories.map((category,index)=><div class:list={['category-panel grid gap-4 sm:grid-cols-2',index>0&&'hidden']} data-panel={category.name} role="tabpanel">{category.items.map(product=><ProductCard product={product}/>)}</div>)}</div><aside class="h-fit rounded-2xl border border-[#d4a373]/35 bg-[#fefae0] p-5 shadow-[0_15px_35px_#8e765522] lg:sticky lg:top-24"><div class="flex items-center justify-between border-b border-[#d4a373]/25 pb-4"><h3 class="serif text-3xl">Tu pedido</h3><span id="order-label" class="text-xs text-[#827568]">Vacío</span></div><div id="order-items" class="divide-y divide-[#d4a373]/20"><p class="py-5 text-sm text-[#827568]">Tu canasta aún está vacía.</p></div><div class="border-t border-[#d4a373]/25 pt-4"><div class="flex justify-between text-sm text-[#827568]"><span>Subtotal</span><span id="subtotal">$0</span></div><div class="mt-2 flex justify-between text-xl font-bold"><span>Total</span><span id="total" class="text-[#a97048]">$0</span></div></div><form id="checkout-form" class="mt-6 space-y-3"><label class="block text-xs font-bold uppercase tracking-wider text-[#6f6256]">Nombre<input required name="name" autocomplete="name" class="mt-1 w-full rounded-lg border border-[#d4a373]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#a97048]" placeholder="Tu nombre"/></label><label class="block text-xs font-bold uppercase tracking-wider text-[#6f6256]">Dirección<input required name="address" autocomplete="street-address" class="mt-1 w-full rounded-lg border border-[#d4a373]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#a97048]" placeholder="¿A dónde llevamos tu pedido?"/></label><label class="block text-xs font-bold uppercase tracking-wider text-[#6f6256]">Notas<textarea name="notes" rows="2" class="mt-1 w-full resize-none rounded-lg border border-[#d4a373]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#a97048]" placeholder="Indicaciones especiales"></textarea></label><button class="button w-full" type="submit">Enviar por WhatsApp ↗</button></form></aside></div></div></section>
