---
import ProductCard from './ProductCard.astro';
import { categories } from '../data/catalog.js';
---
<section id="delivery" class="section bg-[#dce8f8]"><div class="shell reveal"><div class="mb-10 max-w-xl"><p class="eyebrow">Delivery</p><h2 class="serif mt-2 text-5xl leading-none sm:text-6xl">Elige lo que se <em class="text-[#244d86]">horneó para ti.</em></h2><p class="mt-4 text-sm leading-7 text-[#566782]">Elige tus favoritos de la vitrina y mándalos directamente por WhatsApp. Recibimos cada orden con mucho cuidado.</p></div><div class="grid gap-7 lg:grid-cols-[1fr_365px]"><div><div class="mb-5 flex flex-wrap gap-2" role="tablist" aria-label="Categorías">{categories.map((category,index)=><button class:list={['category rounded-full border px-4 py-2 text-xs font-bold transition',index===0?'border-[#315b9a] bg-[#315b9a] text-white':'border-[#315b9a]/45 text-[#31425f]']} data-category={category.name} role="tab" aria-selected={index===0}>{category.name}</button>)}</div>{categories.map((category,index)=><div class:list={['category-panel grid gap-4 sm:grid-cols-2',index>0&&'hidden']} data-panel={category.name} role="tabpanel">{category.items.map(product=><ProductCard product={product}/>)}</div>)}</div><aside class="h-fit rounded-2xl border border-[#315b9a]/35 bg-[#f2f6fc] p-5 shadow-[0_15px_35px_#172b5122] lg:sticky lg:top-24"><div class="flex items-center justify-between border-b border-[#315b9a]/25 pb-4"><h3 class="serif text-3xl">Tu pedido</h3><span id="order-label" class="text-xs text-[#6b7890]">Vacío</span></div><div id="order-items" class="divide-y divide-[#315b9a]/20"><p class="py-5 text-sm text-[#6b7890]">Tu canasta aún está vacía.</p></div><div class="border-t border-[#315b9a]/25 pt-4"><div class="flex justify-between text-sm text-[#6b7890]"><span>Subtotal</span><span id="subtotal">$0</span></div><div class="mt-2 flex justify-between text-xl font-bold"><span>Total</span><span id="total" class="text-[#244d86]">$0</span></div></div><form id="checkout-form" class="mt-6 space-y-3"><label class="block text-xs font-bold uppercase tracking-wider text-[#566782]">Nombre<input required name="name" autocomplete="name" class="mt-1 w-full rounded-lg border border-[#315b9a]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#244d86]" placeholder="Tu nombre"/></label><label class="block text-xs font-bold uppercase tracking-wider text-[#566782]">Dirección<input required name="address" autocomplete="street-address" class="mt-1 w-full rounded-lg border border-[#315b9a]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#244d86]" placeholder="¿A dónde llevamos tu pedido?"/></label><label class="block text-xs font-bold uppercase tracking-wider text-[#566782]">Notas<textarea name="notes" rows="2" class="mt-1 w-full resize-none rounded-lg border border-[#315b9a]/40 bg-white/70 p-3 text-sm outline-none focus:border-[#244d86]" placeholder="Indicaciones especiales"></textarea></label><button class="button w-full" type="submit">Enviar por WhatsApp ↗</button></form></aside></div></div></section>
