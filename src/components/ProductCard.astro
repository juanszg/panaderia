---
// Generic product component used by both catalogue sections.
const { product } = Astro.props;
---
<article class="product overflow-hidden rounded-2xl border border-[#315b9a]/25 bg-white/55"><img class="h-48 w-full object-cover" src={product.image} alt={product.name} loading="lazy"/><div class="p-5"><h3 class="serif text-3xl font-semibold leading-none">{product.name}</h3><p class="mt-3 min-h-10 text-sm leading-5 text-[#566782]">{product.description}</p><div class="mt-5 flex items-center justify-between"><strong class="text-lg text-[#244d86]">${product.price}</strong><button class="add-btn button !px-4 !py-2 !text-xs" data-product={JSON.stringify(product)}>Agregar +</button></div></div></article><style>.product{transition:transform .4s cubic-bezier(.2,.8,.2,1),box-shadow .4s}.product:hover{transform:translateY(-8px) scale(1.015);box-shadow:0 20px 38px #172b5130}.product img{transition:transform .65s cubic-bezier(.2,.8,.2,1),filter .65s}.product:hover img{transform:scale(1.07);filter:saturate(1.1)}</style>
