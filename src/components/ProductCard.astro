---
// Generic product component used by both catalogue sections.
const { product } = Astro.props;
---
<article class="product overflow-hidden rounded-2xl border border-[#d4a373]/25 bg-white/55"><img class="h-48 w-full object-cover" src={product.image} alt={product.name} loading="lazy"/><div class="p-5"><h3 class="serif text-3xl font-semibold leading-none">{product.name}</h3><p class="mt-3 min-h-10 text-sm leading-5 text-[#6f6256]">{product.description}</p><div class="mt-5 flex items-center justify-between"><strong class="text-lg text-[#a97048]">${product.price}</strong><button class="add-btn button !px-4 !py-2 !text-xs" data-product={JSON.stringify(product)}>Agregar +</button></div></div></article><style>.product{transition:transform .3s,box-shadow .3s}.product:hover{transform:translateY(-5px);box-shadow:0 15px 30px #8e76551b}.product img{transition:transform .5s}.product:hover img{transform:scale(1.04)}</style>
