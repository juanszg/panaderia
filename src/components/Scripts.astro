<script>
  // Lightweight client-side cart state. No account, database or backend required.
  const cart = new Map();
  const PHONE = '525540393788';
  const fmt = (amount) => `$${amount.toLocaleString('es-MX')}`;
  const items = document.querySelector('#order-items');
  const subtotal = document.querySelector('#subtotal');
  const total = document.querySelector('#total');
  const count = document.querySelector('#cart-count');
  const label = document.querySelector('#order-label');
  const toast = document.querySelector('#toast');
  let timer;

  function notice(message) {
    toast.textContent = message;
    toast.classList.add('show');
    clearTimeout(timer);
    timer = setTimeout(() => toast.classList.remove('show'), 2500);
  }

  function renderCart() {
    const products = [...cart.values()];
    const sum = products.reduce((amount, product) => amount + product.price * product.quantity, 0);
    const units = products.reduce((amount, product) => amount + product.quantity, 0);
    count.textContent = units;
    label.textContent = units ? `${units} producto${units !== 1 ? 's' : ''}` : 'Vacío';
    subtotal.textContent = fmt(sum);
    total.textContent = fmt(sum);
    items.innerHTML = products.length
      ? products.map((product) => `
        <div class="py-3">
          <div class="flex items-start gap-2">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold">${product.name}</p>
              <p class="text-xs text-[#244d86]">${fmt(product.price)} c/u</p>
            </div>
            <button class="remove text-lg text-[#244d86]" data-id="${product.id}" aria-label="Eliminar">×</button>
          </div>
          <div class="mt-2 flex items-center justify-between">
            <div class="flex items-center gap-3 rounded-md bg-[#eaf1fb] px-2">
              <button class="change" data-id="${product.id}" data-delta="-1" aria-label="Quitar una unidad">−</button>
              <span class="text-xs font-bold">${product.quantity}</span>
              <button class="change" data-id="${product.id}" data-delta="1" aria-label="Agregar una unidad">+</button>
            </div>
            <strong class="text-sm">${fmt(product.quantity * product.price)}</strong>
          </div>
        </div>`).join('')
      : '<p class="py-5 text-sm text-[#6b7890]">Tu canasta aún está vacía.</p>';
  }

  document.addEventListener('click', (event) => {
    const addButton = event.target.closest('.add-btn');
    if (addButton) {
      const product = JSON.parse(addButton.dataset.product);
      const current = cart.get(product.id);
      cart.set(product.id, { ...product, quantity: (current?.quantity || 0) + 1 });
      renderCart();
      notice(`${product.name} se agregó a tu pedido`);
    }

    const changeButton = event.target.closest('.change');
    if (changeButton) {
      const product = cart.get(changeButton.dataset.id);
      product.quantity += Number(changeButton.dataset.delta);
      if (product.quantity < 1) cart.delete(product.id);
      renderCart();
    }

    const removeButton = event.target.closest('.remove');
    if (removeButton) {
      cart.delete(removeButton.dataset.id);
      renderCart();
      notice('Producto eliminado');
    }
  });

  document.querySelectorAll('.category').forEach((tab) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.category').forEach((button) => {
        button.className = 'category rounded-full border border-[#315b9a]/45 px-4 py-2 text-xs font-bold text-[#31425f] transition';
        button.setAttribute('aria-selected', 'false');
      });
      tab.className = 'category rounded-full border border-[#315b9a] bg-[#315b9a] px-4 py-2 text-xs font-bold text-white transition';
      tab.setAttribute('aria-selected', 'true');
      document.querySelectorAll('.category-panel').forEach((panel) => {
        panel.classList.toggle('hidden', panel.dataset.panel !== tab.dataset.category);
      });
    });
  });

  document.querySelector('#checkout-form').addEventListener('submit', (event) => {
    event.preventDefault();
    if (!cart.size) return notice('Agrega algo a tu pedido primero');

    const data = new FormData(event.currentTarget);
    const products = [...cart.values()];
    const sum = products.reduce((amount, product) => amount + product.price * product.quantity, 0);
    const rows = products.map((product) => `• ${product.quantity}x ${product.name} — ${fmt(product.quantity * product.price)}`).join('\n');
    const message = `¡Hola, La Miga! 😊 Me gustaría hacer este pedido:\n\nNombre: ${data.get('name')}\nDirección: ${data.get('address')}\nNotas: ${data.get('notes') || 'Sin notas'}\n\nMi pedido:\n${rows}\n\nTOTAL: ${fmt(sum)}\n\n¡Muchas gracias por tu compra! ❤️`;
    window.open(`https://wa.me/${PHONE}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    window.alert('¡Muchas gracias por tu compra! ❤️');
  });

  const menuToggle = document.querySelector('#menu-toggle');
  const navLinks = document.querySelector('#nav-links');
  function setMenuOpen(open) {
    if (!menuToggle || !navLinks) return;
    navLinks.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  }
  menuToggle?.addEventListener('click', () => setMenuOpen(menuToggle.getAttribute('aria-expanded') !== 'true'));
  document.querySelectorAll('#nav-links a').forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuToggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      menuToggle.focus();
    }
  });
  document.addEventListener('click', (event) => {
    if (menuToggle?.getAttribute('aria-expanded') === 'true' && !navLinks.contains(event.target) && !menuToggle.contains(event.target)) {
      setMenuOpen(false);
    }
  });
  window.matchMedia('(min-width: 1024px)').addEventListener('change', () => setMenuOpen(false));

  const specialDialog = document.querySelector('#special-order-dialog');
  const specialForm = document.querySelector('#special-order-form');
  const specialOpen = document.querySelector('#special-order-open');
  function closeSpecialDialog() {
    if (specialDialog.open) specialDialog.close();
  }
  specialOpen.addEventListener('click', () => specialDialog.showModal());
  document.querySelector('#special-order-close').addEventListener('click', closeSpecialDialog);
  document.querySelector('#special-order-cancel').addEventListener('click', closeSpecialDialog);
  specialDialog.addEventListener('click', (event) => {
    if (event.target === specialDialog) closeSpecialDialog();
  });
  specialForm.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(specialForm);
    const date = data.get('date') || 'Por definir';
    const notes = data.get('notes') || 'Sin detalles adicionales';
    const message = `¡Hola, La Miga! 😊 Quiero cotizar un pedido especial.\n\nNombre: ${data.get('name')}\nQué me gustaría: ${data.get('product')}\nCantidad: ${data.get('quantity')}\nFecha deseada: ${date}\nIngredientes o preferencias: ${data.get('ingredients')}\nElaboración especial: ${data.get('preparation')}\nDetalles extra: ${notes}\n\n¡Gracias por ayudarnos a crear algo especial! 💙`;
    window.open(`https://wa.me/${PHONE}?text=${encodeURIComponent(message)}`, '_blank', 'noopener');
    closeSpecialDialog();
    specialForm.reset();
    window.alert('¡Gracias por compartir tu idea con La Miga! 💙 Abrimos WhatsApp para coordinar los detalles.');
  });

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('visible'));
  }, { threshold: 0.1 });
  document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
</script>
