<script>
// Lightweight client-side cart state. No account, database or backend required.
const cart=new Map(),PHONE='5210000000000',fmt=n=>`$${n.toLocaleString('es-MX')}`;const items=document.querySelector('#order-items'),subtotal=document.querySelector('#subtotal'),total=document.querySelector('#total'),count=document.querySelector('#cart-count'),label=document.querySelector('#order-label'),toast=document.querySelector('#toast');let timer;
function notice(text){toast.textContent=text;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),2500)}
function render(){const list=[...cart.values()],sum=list.reduce((n,p)=>n+p.price*p.quantity,0),units=list.reduce((n,p)=>n+p.quantity,0);count.textContent=units;label.textContent=units?`${units} producto${units!==1?'s':''}`:'Vacío';subtotal.textContent=fmt(sum);total.textContent=fmt(sum);items.innerHTML=list.length?list.map(p=>`<div class="py-3"><div class="flex items-start gap-2"><div class="min-w-0 flex-1"><p class="text-sm font-bold">${p.name}</p><p class="text-xs text-[#a97048]">${fmt(p.price)} c/u</p></div><button class="remove text-lg text-[#a97048]" data-id="${p.id}" aria-label="Eliminar">×</button></div><div class="mt-2 flex items-center justify-between"><div class="flex items-center gap-3 rounded-md bg-[#faedcd] px-2"><button class="change" data-id="${p.id}" data-delta="-1">−</button><span class="text-xs font-bold">${p.quantity}</span><button class="change" data-id="${p.id}" data-delta="1">+</button></div><strong class="text-sm">${fmt(p.quantity*p.price)}</strong></div></div>`).join(''):'<p class="py-5 text-sm text-[#827568]">Tu canasta aún está vacía.</p>'}
document.addEventListener('click',e=>{const add=e.target.closest('.add-btn');if(add){const p=JSON.parse(add.dataset.product),old=cart.get(p.id);cart.set(p.id,{...p,quantity:(old?.quantity||0)+1});render();notice(`${p.name} se agregó a tu pedido`)}const ch=e.target.closest('.change');if(ch){const p=cart.get(ch.dataset.id);p.quantity+=+ch.dataset.delta;if(p.quantity<1)cart.delete(p.id);render()}const remove=e.target.closest('.remove');if(remove){cart.delete(remove.dataset.id);render();notice('Producto eliminado')}});
document.querySelectorAll('.category').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.category').forEach(b=>{b.className='category rounded-full border border-[#d4a373]/45 px-4 py-2 text-xs font-bold text-[#675847] transition';b.setAttribute('aria-selected','false')});t.className='category rounded-full border border-[#d4a373] bg-[#d4a373] px-4 py-2 text-xs font-bold text-white transition';t.setAttribute('aria-selected','true');document.querySelectorAll('.category-panel').forEach(p=>p.classList.toggle('hidden',p.dataset.panel!==t.dataset.category))}));
document.querySelector('#checkout-form').addEventListener('submit',e=>{e.preventDefault();if(!cart.size)return notice('Agrega algo a tu pedido primero');const d=new FormData(e.currentTarget),list=[...cart.values()],sum=list.reduce((n,p)=>n+p.price*p.quantity,0),rows=list.map(p=>`• ${p.quantity}x ${p.name} — ${fmt(p.quantity*p.price)}`).join('\n');const msg=`NUEVO PEDIDO LILY\n\nNombre: ${d.get('name')}\nDirección: ${d.get('address')}\nNotas: ${d.get('notes')||'Sin notas'}\n\nPedido:\n${rows}\n\nTOTAL: ${fmt(sum)}`;window.open(`https://wa.me/${PHONE}?text=${encodeURIComponent(msg)}`,'_blank','noopener')});
const mt=document.querySelector('#menu-toggle'),nl=document.querySelector('#nav-links');mt?.addEventListener('click',()=>{const hidden=nl.classList.toggle('hidden');mt.setAttribute('aria-expanded',String(!hidden))});document.querySelectorAll('#nav-links a').forEach(a=>a.addEventListener('click',()=>nl.classList.add('hidden')));const observer=new IntersectionObserver(es=>es.forEach(e=>e.isIntersecting&&e.target.classList.add('visible')),{threshold:.1});document.querySelectorAll('.reveal').forEach(e=>observer.observe(e));
</script>
