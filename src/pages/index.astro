---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import ProductCard from "../components/ProductCard.astro";
import Delivery from "../components/Delivery.astro";
import Scripts from "../components/Scripts.astro";
import { featured, gallery } from "../data/catalog.js";
---

<BaseLayout>
  <Navbar />
  <main>
    <!-- Official La Miga branding and photography. -->
    <section
      id="inicio"
      class="relative flex min-h-screen items-center overflow-hidden bg-[#1d3158] px-5 pt-[68px]"
    >
      <div
        class="absolute right-[-13%] top-[8%] h-[420px] w-[420px] rounded-full bg-[#315b9a]/45 blur-3xl sm:h-[600px] sm:w-[600px]"
      >
      </div><div
        class="shell relative grid items-center gap-10 py-14 lg:grid-cols-[.9fr_1.1fr]"
      >
        <div class="reveal">
          <p class="eyebrow text-[#c4d6f1]">Panadería artesanal · desde 2018</p><h1
            class="serif mt-4 text-6xl font-semibold leading-[.9] tracking-tight text-white sm:text-7xl sm:leading-[.8] lg:text-9xl"
          >
            LA MIGA
          </h1><p
            class="serif mt-7 max-w-md text-3xl leading-[.95] text-[#dce8f8] sm:text-4xl"
          >
            Horneamos momentos que se quedan contigo.
          </p><p class="mt-5 max-w-md text-sm leading-7 text-[#d7e1f1]">
            Pan, viennoiserie y dulces hechos con ingredientes honestos, tiempo
            y mucha delicadeza.
          </p><div class="mt-8 flex flex-wrap gap-3">
            <a href="#delivery" class="button w-full sm:w-auto"
              >Ordenar delivery <span>→</span></a
            ><a href="#menu" class="button button-outline w-full sm:w-auto">Ver selección</a>
          </div>
        </div><div class="reveal relative" style="transition-delay:.12s">
          <div
            class="absolute -inset-4 rounded-[3rem] bg-[#315b9a]/25 blur-2xl"
          >
          </div><img
            src="/img/pan3.PNG"
            alt="Pan artesanal recién horneado"
            fetchpriority="high"
            class="relative h-[300px] w-full rounded-[2rem] object-cover shadow-[0_22px_50px_#172b512b] sm:h-[430px] lg:h-[500px]"
          /><div
            class="absolute bottom-5 left-5 rounded-xl border border-white/50 bg-[#f2f6fc]/85 px-4 py-3 text-xs font-semibold text-[#31425f] backdrop-blur"
          >
            Horneado hoy, para tu mesa.
          </div>
        </div>
      </div>
    </section>
    <!-- Product image grid. -->
    <section id="galeria" class="section bg-white/60">
      <div class="shell reveal">
        <div class="mb-9 flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="eyebrow">La vitrina</p><h2
              class="serif mt-2 text-5xl leading-none sm:text-6xl"
            >
              Hecho <em class="text-[#244d86]">con paciencia.</em>
            </h2>
          </div><p class="max-w-xs text-sm leading-6 text-[#5b6b85]">
            Detalles simples, ingredientes elegidos y el aroma que anuncia algo
            bueno.
          </p>
        </div><div class="grid grid-cols-2 gap-3 md:grid-cols-4">
          {
            gallery.map((image, index) => (
              <figure
                class:list={[
                  "gallery overflow-hidden rounded-2xl",
                  (index === 0 || index === 5) && "md:row-span-2",
                ]}
              >
                <img
                  src={image}
                  alt={`Producto de panadería La Miga ${index + 1}`}
                  loading="lazy"
                  class="h-full min-h-40 w-full object-cover"
                />
              </figure>
            ))
          }
        </div>
      </div>
    </section>
    <!-- Editorial selection of products. -->
    <section id="menu" class="section bg-[#eaf1fb]">
      <div class="shell reveal">
        <div class="mb-9">
          <p class="eyebrow">Selección de la casa</p><h2
            class="serif mt-2 text-5xl leading-none sm:text-6xl"
          >
            Pequeños placeres, <em class="text-[#244d86]">gran oficio.</em>
          </h2>
        </div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {featured.map((product) => <ProductCard product={product} />)}
        </div>
      </div>
    </section>
    <!-- Brand story section. -->
    <section id="nosotros" class="section bg-[#f2f6fc]">
      <div class="shell grid items-center gap-10 lg:grid-cols-2">
        <div class="reveal">
          <img
            src="/img/pan7.PNG"
            alt="Pan de chocolate artesanal La Miga"
            loading="lazy"
            class="h-[420px] w-full rounded-[2rem] object-cover shadow-[0_18px_40px_#172b5122]"
          />
        </div><div class="reveal">
          <p class="eyebrow">Nuestra historia</p><h2
            class="serif mt-2 text-5xl leading-none sm:text-6xl"
          >
            Una pausa <em class="text-[#244d86]">bien hecha.</em>
          </h2><p class="mt-6 max-w-lg text-sm leading-7 text-[#5b6b85]">
            En La Miga creemos que el pan recién hecho reúne a las personas.
            Cada pieza se prepara con cuidado, buenos ingredientes y el cariño
            de un oficio hecho a mano.
          </p><div class="mt-7 grid gap-4 sm:grid-cols-2">
            <div class="rounded-xl border border-[#315b9a]/30 bg-white/60 p-5">
              <h3 class="serif text-3xl">Misión</h3><p
                class="mt-2 text-sm leading-6 text-[#5b6b85]"
              >
                Acompañar tus días con panadería honesta y memorable.
              </p>
            </div><div
              class="rounded-xl border border-[#315b9a]/30 bg-white/60 p-5"
            >
              <h3 class="serif text-3xl">Valores</h3><p
                class="mt-2 text-sm leading-6 text-[#5b6b85]"
              >
                Calidad, calma, cercanía y respeto por el oficio.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>
    <Delivery />
    <section id="pedido" class="relative isolate overflow-hidden bg-[#f0a65e] px-5 py-16 sm:py-20">
      <div class="pointer-events-none absolute -right-24 -top-28 -z-10 h-72 w-72 rounded-full border-[36px] border-white/20 sm:h-96 sm:w-96"></div>
      <div class="shell reveal grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div class="max-w-2xl">
          <p class="text-xs font-extrabold uppercase tracking-[.22em] text-[#71360f]">Hecho especialmente para ti</p>
          <h2 class="serif mt-3 text-5xl font-semibold leading-[.95] text-[#172b51] sm:text-6xl">Arma tu pedido</h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-[#54351f] sm:text-base">¿Tienes una idea, una celebración o antojo de algo distinto? Cuéntanos cantidades, ingredientes y cómo te gustaría prepararlo. Lo hacemos realidad contigo.</p>
        </div>
        <button id="special-order-open" type="button" class="special-order-cta inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-[#172b51] px-9 py-5 text-sm font-bold text-white shadow-xl transition hover:-translate-y-1 hover:bg-[#244d86] focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-white/70">
          Diseñar mi pedido <span aria-hidden="true">↗</span>
        </button>
      </div>
    </section>
    <dialog id="special-order-dialog" aria-labelledby="special-order-title" aria-describedby="special-order-description" class="special-dialog w-[min(92vw,680px)] max-h-[90vh] overflow-y-auto rounded-[1.75rem] border-0 bg-[#f2f6fc] p-0 text-[#31425f] shadow-2xl">
      <div class="p-6 sm:p-8">
        <div class="mb-6 flex items-start justify-between gap-5">
          <div>
            <p class="text-xs font-extrabold uppercase tracking-[.18em] text-[#9b4d19]">Pedido especial</p>
            <h2 id="special-order-title" class="serif mt-1 text-4xl font-semibold leading-none text-[#1d3158]">Cuéntanos tu idea</h2>
            <p id="special-order-description" class="mt-2 text-sm leading-6 text-[#5b6b85]">Te contactaremos por WhatsApp para confirmar los detalles.</p>
          </div>
          <button id="special-order-close" type="button" class="grid h-10 w-10 shrink-0 place-items-center rounded-full border border-[#315b9a]/20 text-2xl leading-none text-[#1d3158] transition hover:rotate-90 hover:bg-[#dce8f8]" aria-label="Cerrar formulario">×</button>
        </div>
        <form id="special-order-form" class="grid gap-4 sm:grid-cols-2">
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f]">Tu nombre
            <input required name="name" autocomplete="name" autofocus class="special-input" placeholder="¿Cómo te llamas?" />
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f]">¿Qué te gustaría?
            <input required name="product" class="special-input" placeholder="Ej. pastel, pan, galletas..." />
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f]">Cantidad
            <input required type="number" name="quantity" min="1" max="1000" inputmode="numeric" class="special-input" placeholder="Piezas o porciones" />
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f]">¿Para cuándo?
            <input type="date" name="date" class="special-input" />
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f] sm:col-span-2">Ingredientes o preferencias
            <textarea required name="ingredients" rows="2" class="special-input resize-y" placeholder="Ingredientes favoritos, alergias o restricciones"></textarea>
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f] sm:col-span-2">Elaboración especial
            <textarea required name="preparation" rows="3" class="special-input resize-y" placeholder="Cuéntanos el sabor, acabado, decoración o preparación que imaginas"></textarea>
          </label>
          <label class="text-xs font-bold uppercase tracking-wide text-[#31425f] sm:col-span-2">Detalles extra <span class="font-normal normal-case tracking-normal text-[#6b7890]">(opcional)</span>
            <textarea name="notes" rows="2" class="special-input resize-y" placeholder="Colores, ocasión, presupuesto aproximado u otro detalle"></textarea>
          </label>
          <div class="mt-1 flex flex-col-reverse gap-3 sm:col-span-2 sm:flex-row sm:justify-end">
            <button id="special-order-cancel" type="button" class="rounded-full border border-[#315b9a]/30 px-6 py-3 text-sm font-semibold text-[#31425f] transition hover:bg-[#e4edf9]">Ahora no</button>
            <button type="submit" class="button justify-center">Enviar idea por WhatsApp ↗</button>
          </div>
        </form>
      </div>
    </dialog>
  </main>
  <!-- Update this WhatsApp number and the one in Scripts.astro before production. -->
  <a
    class="fixed bottom-6 left-5 z-40 grid h-12 w-12 place-items-center rounded-full bg-[#25D366] text-lg text-white shadow-lg transition hover:scale-110"
    href="https://wa.me/525540393788"
    target="_blank"
    rel="noopener"
    aria-label="Contactar a La Miga por WhatsApp">
    <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true" fill="none">
      <path d="M16 3.25c-7.04 0-12.75 5.57-12.75 12.44 0 2.22.61 4.4 1.77 6.31L3.25 28.5l6.75-1.74a13 13 0 0 0 6 1.46c7.04 0 12.75-5.57 12.75-12.44S23.04 3.25 16 3.25Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
      <path d="M11.2 9.8c-.28-.62-.58-.64-.85-.65h-.72c-.25 0-.66.09-1.01.47-.35.38-1.33 1.28-1.33 3.12s1.36 3.62 1.55 3.87c.19.25 2.62 4.12 6.47 5.61 3.2 1.24 3.85.99 4.55.93.7-.06 2.26-.9 2.58-1.78.32-.87.32-1.62.23-1.78-.1-.15-.35-.25-.73-.43-.39-.19-2.26-1.1-2.61-1.22-.35-.13-.6-.19-.85.19-.26.37-.98 1.21-1.2 1.46-.22.25-.45.28-.84.09-.39-.19-1.63-.59-3.1-1.88-1.15-1.01-1.93-2.26-2.16-2.64-.22-.37-.02-.57.17-.75.17-.16.39-.43.58-.65.19-.22.25-.37.38-.62.13-.25.07-.47-.03-.66-.09-.19-.84-2.02-1.08-2.68Z" fill="currentColor" />
    </svg>
  </a
  ><a
    class="fixed bottom-6 right-5 z-40 grid h-12 w-12 place-items-center rounded-full border border-[#315b9a]/60 bg-[#f2f6fc]/90 text-[#244d86] shadow-lg transition hover:-translate-y-1"
    href="#inicio"
    aria-label="Volver arriba">↑</a
  ><div id="toast" class="toast" role="status" aria-live="polite"></div>
  <footer
    class="border-t border-[#315b9a]/25 bg-[#f2f6fc] px-5 py-8 text-center text-xs text-[#6b7890]"
  >
    <p class="serif text-2xl tracking-[.18em] text-[#1d3158]">LA MIGA</p><p
      class="mt-2"
    >
      Panadería artesanal · © {new Date().getFullYear()}
    </p>
  </footer>
  <Scripts />
</BaseLayout>
<style>
  .special-dialog::backdrop {
    background: rgb(12 27 54 / 72%);
    backdrop-filter: blur(5px);
  }
  .special-dialog[open] {
    animation: special-dialog-in 0.28s cubic-bezier(.2,.8,.2,1) both;
  }
  .special-input {
    display: block;
    width: 100%;
    margin-top: .4rem;
    border: 1px solid rgb(49 91 154 / 28%);
    border-radius: .8rem;
    background: white;
    padding: .8rem .9rem;
    color: #1d3158;
    font-size: .9rem;
    font-weight: 400;
    line-height: 1.5;
    text-transform: none;
    letter-spacing: normal;
    outline: none;
    transition: border-color .2s, box-shadow .2s, background-color .2s;
  }
  .special-input::placeholder { color: #8290a6; }
  .special-input:focus {
    border-color: #315b9a;
    background: #fbfdff;
    box-shadow: 0 0 0 3px rgb(49 91 154 / 14%);
  }
  @keyframes special-dialog-in {
    from { opacity: 0; transform: translateY(18px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .gallery img {
    transition: transform 0.65s cubic-bezier(.2,.8,.2,1), filter .65s;
  }
  .gallery:hover img {
    transform: scale(1.09);
    filter: saturate(1.12);
  }
  @media (min-width: 768px) {
    .gallery {
      min-height: 200px;
    }
    .gallery:nth-child(1),
    .gallery:nth-child(6) {
      min-height: 416px;
    }
  }
</style>
