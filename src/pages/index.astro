---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import ProductCard from '../components/ProductCard.astro';
import Delivery from '../components/Delivery.astro';
import Scripts from '../components/Scripts.astro';
import { featured, gallery } from '../data/catalog.js';
---
<BaseLayout>
  <Navbar />
  <main>
    <!-- A calm editorial hero for the LILY bakery brand. -->
    <section id="inicio" class="relative flex min-h-screen items-center overflow-hidden bg-[#fefae0] px-5 pt-[68px]"><div class="absolute right-[-13%] top-[8%] h-[600px] w-[600px] rounded-full bg-[#e9edc9] blur-3xl"></div><div class="shell relative grid items-center gap-10 py-14 lg:grid-cols-[.9fr_1.1fr]"><div class="reveal"><p class="eyebrow">Panadería artesanal · desde 2018</p><h1 class="serif mt-4 text-7xl font-semibold leading-[.8] text-[#504234] sm:text-8xl lg:text-9xl">LILY</h1><p class="serif mt-7 max-w-md text-3xl leading-[.95] text-[#a97048] sm:text-4xl">Horneamos momentos que se quedan contigo.</p><p class="mt-5 max-w-md text-sm leading-7 text-[#74685c]">Pan, viennoiserie y dulces hechos con ingredientes honestos, tiempo y mucha delicadeza.</p><div class="mt-8 flex flex-wrap gap-3"><a href="#delivery" class="button">Ordenar delivery <span>→</span></a><a href="#menu" class="button button-outline">Ver selección</a></div></div><div class="reveal relative" style="transition-delay:.12s"><div class="absolute -inset-4 rounded-[3rem] bg-[#d4a373]/25 blur-2xl"></div><img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=1500&q=90" alt="Pan artesanal recién horneado" fetchpriority="high" class="relative h-[390px] w-full rounded-[2rem] object-cover shadow-[0_22px_50px_#8e76552b] sm:h-[540px]"/><div class="absolute bottom-5 left-5 rounded-xl border border-white/50 bg-[#fefae0]/85 px-4 py-3 text-xs font-semibold text-[#675847] backdrop-blur">Horneado hoy, para tu mesa.</div></div></div></section>
    <!-- Product image grid. -->
    <section id="galeria" class="section bg-white/60"><div class="shell reveal"><div class="mb-9 flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">La vitrina</p><h2 class="serif mt-2 text-5xl leading-none sm:text-6xl">Hecho <em class="text-[#a97048]">con paciencia.</em></h2></div><p class="max-w-xs text-sm leading-6 text-[#74685c]">Detalles simples, ingredientes elegidos y el aroma que anuncia algo bueno.</p></div><div class="grid grid-cols-2 gap-3 md:grid-cols-4">{gallery.map((image,index)=><figure class:list={['gallery overflow-hidden rounded-2xl', (index===0||index===5)&&'md:row-span-2']}><img src={image} alt={`Producto de panadería LILY ${index+1}`} loading="lazy" class="h-full min-h-40 w-full object-cover"/></figure>)}</div></div></section>
    <!-- Editorial selection of products. -->
    <section id="menu" class="section bg-[#faedcd]"><div class="shell reveal"><div class="mb-9"><p class="eyebrow">Selección de la casa</p><h2 class="serif mt-2 text-5xl leading-none sm:text-6xl">Pequeños placeres, <em class="text-[#a97048]">gran oficio.</em></h2></div><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{featured.map(product=><ProductCard product={product}/>)}</div></div></section>
    <!-- Brand story section. -->
    <section id="nosotros" class="section bg-[#fefae0]"><div class="shell grid items-center gap-10 lg:grid-cols-2"><div class="reveal"><img src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=1200&q=85" alt="Croissants artesanales sobre una mesa" loading="lazy" class="h-[420px] w-full rounded-[2rem] object-cover shadow-[0_18px_40px_#8e765522]"/></div><div class="reveal"><p class="eyebrow">Nuestra historia</p><h2 class="serif mt-2 text-5xl leading-none sm:text-6xl">Una pausa <em class="text-[#a97048]">bien hecha.</em></h2><p class="mt-6 max-w-lg text-sm leading-7 text-[#74685c]">LILY nació como una cocina pequeña y una idea grande: recuperar el placer de un pan bien hecho. Cada pieza respeta su tiempo de fermentación, su origen y a quien la compartirá.</p><div class="mt-7 grid gap-4 sm:grid-cols-2"><div class="rounded-xl border border-[#d4a373]/30 bg-white/60 p-5"><h3 class="serif text-3xl">Misión</h3><p class="mt-2 text-sm leading-6 text-[#74685c]">Acompañar tus días con panadería honesta y memorable.</p></div><div class="rounded-xl border border-[#d4a373]/30 bg-white/60 p-5"><h3 class="serif text-3xl">Valores</h3><p class="mt-2 text-sm leading-6 text-[#74685c]">Calidad, calma, cercanía y respeto por el oficio.</p></div></div></div></div></section>
    <Delivery />
  </main>
  <!-- Update this WhatsApp number and the one in Scripts.astro before production. -->
  <a class="fixed bottom-6 left-5 z-40 grid h-12 w-12 place-items-center rounded-full bg-[#25D366] text-lg text-white shadow-lg transition hover:scale-110" href="https://wa.me/5210000000000" target="_blank" rel="noopener" aria-label="WhatsApp">◔</a><a class="fixed bottom-6 right-5 z-40 grid h-12 w-12 place-items-center rounded-full border border-[#d4a373]/60 bg-[#fefae0]/90 text-[#a97048] shadow-lg transition hover:-translate-y-1" href="#inicio" aria-label="Volver arriba">↑</a><div id="toast" class="toast" role="status" aria-live="polite"></div>
  <footer class="border-t border-[#d4a373]/25 bg-[#fefae0] px-5 py-8 text-center text-xs text-[#827568]"><p class="serif text-2xl tracking-[.18em] text-[#6d5944]">LILY</p><p class="mt-2">Panadería artesanal · © {new Date().getFullYear()}</p></footer>
  <Scripts />
</BaseLayout>
<style>.gallery img{transition:transform .55s}.gallery:hover img{transform:scale(1.07)}@media(min-width:768px){.gallery{min-height:200px}.gallery:nth-child(1),.gallery:nth-child(6){min-height:416px}}</style>
